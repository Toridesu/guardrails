{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "C01DenyOutsideAllowedRegions",
      "Effect": "Deny",
      "NotAction": [
        "account:*",
        "aws-marketplace:*",
        "aws-portal:*",
        "billing:*",
        "budgets:*",
        "ce:*",
        "cloudfront:*",
        "cur:*",
        "ec2:DescribeRegions",
        "freetier:*",
        "globalaccelerator:*",
        "health:*",
        "iam:*",
        "invoicing:*",
        "notifications:*",
        "notifications-contacts:*",
        "organizations:*",
        "payments:*",
        "pricing:*",
        "route53:*",
        "route53domains:*",
        "s3:GetAccountPublicAccessBlock",
        "s3:GetBucketLocation",
        "s3:ListAllMyBuckets",
        "savingsplans:*",
        "shield:*",
        "sso:*",
        "sts:*",
        "support:*",
        "tax:*",
        "trustedadvisor:*",
        "waf:*",
        "wafv2:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "${primary_region}",
            "${secondary_region}"
          ]
        }
      }
    },
    {
      "Sid": "C01DenyOsakaExceptBedrock",
      "Effect": "Deny",
      "NotAction": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream",
        "sts:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${secondary_region}"
        }
      }
    }
  ]
}
