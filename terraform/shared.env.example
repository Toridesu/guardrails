# 自分で決める値。コピーして使う：cp terraform/shared.env.example terraform/shared.env
# shared.env は git の管理外。scripts/tf.sh が読み込み、TF_VAR_<変数名> として Terraform に渡す。
# そのフォルダが使わない値は、Terraform が警告なしで無視する。
# アカウント ID などは、tf.sh が org の出力から渡すので、ここには書かない。

# Terraform を実行する management アカウントのプロファイル（aws configure sso で作る）
AWS_PROFILE=guardrails-management

# メンバーアカウントのルートのメールアドレス（ほかの AWS アカウントで使っていないもの）
TF_VAR_security_account_email=you+guardrails-security@example.com
TF_VAR_workload_account_email=you+guardrails-workload@example.com

# 予算アラートと、管理者ロールが使われたときの通知先
TF_VAR_notification_email=you@example.com

# ログバケットの名前（世界で一意にする）
TF_VAR_log_bucket_name=guardrails-logs-CHANGE-ME

# 月額予算（ドル）
TF_VAR_monthly_budget_usd=20

# Identity Center のユーザー ID。Identity Center を有効にしてユーザーを作ったあとで書き、org をもう一度 apply する
TF_VAR_sso_admin_user_id=
