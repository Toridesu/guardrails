# デモの設定。コピーして書き換える：cp scripts/demo/demo.env.example scripts/demo/demo.env
# demo.env は git の管理外。
#
# プロファイルは Identity Center の GuardrailsAdmin で作る（aws configure sso）。
# 管理者ロール（OrganizationAccountAccessRole）は SCP の例外なので、拒否されずデモにならない。
WORKLOAD_PROFILE=guardrails-workload
SECURITY_PROFILE=guardrails-security

# terraform/logging の log_bucket_name と同じ値
LOG_BUCKET=

PRIMARY_REGION=ap-northeast-1
SECONDARY_REGION=ap-northeast-3
ADMIN_ROLE_NAME=OrganizationAccountAccessRole

# デモ4：既定の VPC がなければ、セキュリティグループを作る VPC を書く
VPC_ID=
# デモ5：プルリクエストの向き先
BASE_BRANCH=main
